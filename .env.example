# 이 파일을 복사해 .env.local로 사용하세요.
# 새 환경변수를 추가하면 src/env.ts 스키마에도 함께 반영해야 합니다.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# https://www.notion.so/my-integrations 에서 Integration 생성 후 발급되는
# Internal Integration Secret
NOTION_API_KEY=

# 대상 Notion Database 페이지 URL에서 추출한 32자리 ID
# (예: notion.so/워크스페이스/1234567890abcdef1234567890abcdef?v=... 형태에서
#  물음표 앞 32자리 부분). Database 우측 상단 "..." > Connections에서
# 위에서 만든 Integration을 반드시 Connect 해야 조회가 가능합니다.
NOTION_DATABASE_ID=
